# ==============================================================================
# PatchGarden — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PORT=3001
LOG_LEVEL=info

# ── Database (SQLite path for local; swap for Postgres URI in production) ──────
DATABASE_URL=file:./patchgarden.db

# ── Ollama / Local AI ─────────────────────────────────────────────────────────
# URL of the Ollama Docker container
OLLAMA_BASE_URL=http://localhost:11434
# Which Gemma model to use (must be pulled in Ollama first)
OLLAMA_MODEL=gemma3:4b
# Max tokens to send in a single context window
OLLAMA_MAX_CONTEXT_TOKENS=4096
# Inference timeout in seconds
OLLAMA_TIMEOUT_SECONDS=120

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=patchgarden
TEMPORAL_TASK_QUEUE=patchgarden-worker

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
# Enable Sentry Agent Tracing (experimental)
SENTRY_ENABLE_AGENT_TRACING=true

# ── Render (Deployment) ───────────────────────────────────────────────────────
# Set automatically by Render; used to detect hosted environment
RENDER=false
RENDER_SERVICE_ID=

# ── GitHub Workflow ───────────────────────────────────────────────────────────
# Token for GitHub API operations (read-only for repo inspection by default)
# Required scopes: repo (read), contents (read)
GITHUB_TOKEN=

# ── Security ──────────────────────────────────────────────────────────────────
# Secret used for signing internal job tokens
JOB_SECRET=change-me-before-production
# Maximum repository size in MB to accept for analysis
MAX_REPO_SIZE_MB=500
# Maximum allowed workspace path depth (prevents path traversal)
MAX_PATH_DEPTH=10

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to true to enable dry-run mode (never writes to disk)
ENABLE_DRY_RUN=false
# Allow automatic test execution (set to false for manual-approval environments)
ENABLE_AUTO_TEST=true
