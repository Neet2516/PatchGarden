{
  "name": "@patchgarden/api",
  "version": "0.1.0",
  "description": "PatchGarden HTTP API and WebSocket server",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsx watch src/index.ts",
