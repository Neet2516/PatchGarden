    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@patchgarden/core": "*",
    "@temporalio/client": "^1.11.0",
    "@sentry/node": "^8.0.0",
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
